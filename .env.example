# WindSight backend configuration.
# Every value is optional - the entries below are the defaults used when the
# variable is unset. Copy to `.env` (or set them in your host's dashboard).

# Directory containing actuals.json / forecasts.json / analysis.json
DATA_DIR=./data

# Delivery period covered by the dataset
DELIVERY_FROM=2026-01-01
DELIVERY_TO=2026-01-31

# Day-ahead purchasing decision cutoff
DECISION_CUTOFF_HOUR=10
DECISION_CUTOFF_MINUTE=0
DECISION_CUTOFF_TIMEZONE=Europe/London
DECISION_CUTOFF_LEAD_DAYS=1

# CORS: comma-separated allowed origins (set to the deployed frontend origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3
